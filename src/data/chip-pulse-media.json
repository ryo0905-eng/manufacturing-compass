      "id": "tsmc-capital-appropriation-2026-09",
      "sourceId": "tsmc",
      "sourceName": "SEC / TSMC Form 6-K",
      "sourceUrl": "https://www.sec.gov/Archives/edgar/data/1046179/000104617926000660/tsm-monthend6kx20260924.htm",
      "publishedAt": "2026-09-24T10:02:44.000Z",
