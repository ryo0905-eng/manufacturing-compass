    {
      "id": "sec-0000950103-26-013682",
      "sourceId": "ase",
      "sourceName": "SEC EDGAR",
      "sourceUrl": "https://www.sec.gov/Archives/edgar/data/1122411/000095010326013682/dp253117_6k.htm",
      "title": "ASEの後工程事業、8月売上は前年同月比53.1%増",
      "publishedAt": "2026-09-09T10:03:31.000Z",
      "datePrecision": "instant",
      "version": 2,
      "summary": "ASEは2026年8月の組立・テスト・材料事業（ATM）の売上高を512.87億台湾ドルと公表しました。前年同月比53.1%増、前月比7.9%増です。",
      "facts": [
        "数値は未監査です。ATM事業の売上であり、ASE全社の連結売上とは範囲が異なります。",
        "前年同月比53.1%は会社公表値です。表の金額（51,287百万台湾ドルと33,510百万台湾ドル）から再計算すると約53.0%となり、差の理由はこの資料では確認できません。"
      ],
      "unknowns": [
        "この資料だけでは、先端パッケージ単独の売上や、増収に寄与した個別顧客は確認できません。"
      ],
      "fields": [
        "packaging"
      ],
      "processes": [
        "Assembly",
        "Test"
      ],
      "companyNames": [
        "ASE Technology"
      ],
      "stage": "result",
      "evidence": [
        {
          "locator": "ATM net revenues (unaudited) / NT$ Million",
          "quote": "Net revenues for ATM assembly, testing and material business are as follows:"
        },
        {
          "locator": "ATM net revenues (unaudited) / NT$ Million",
          "quote": "51,287 47,524 33,510 +7.9% +53.1%"
        }
      ],
