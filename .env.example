# Jev demo: server-side only. Configure the API key budget in Vercel first.
# Add these entries to .env.local; preserve other settings.
JEV_DEMO_ENABLED=false
AI_GATEWAY_API_KEY=

# Chip Pulse SEC collector: enter a contact email, or an organization name followed by a contact email.
# When only an email is set, the collector adds "Manufacturing Compass" to the SEC User-Agent.
# Server/operator only. Example format: Manufacturing Compass admin@example.com
CHIP_PULSE_SEC_USER_AGENT=
