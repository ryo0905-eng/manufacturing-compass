# Jev demo: server-side only. Configure the API key budget in Vercel first.
# Add these entries to .env.local; preserve other settings.
JEV_DEMO_ENABLED=false
AI_GATEWAY_API_KEY=

# Chip Pulse SEC collector: enter a contact email, or an organization name followed by a contact email.
# When only an email is set, the collector adds "Manufacturing Compass" to the SEC User-Agent.
# Server/operator only. Example format: Manufacturing Compass admin@example.com
CHIP_PULSE_SEC_USER_AGENT=

# Optional Clarity: Vercel Production only, ranking article + explicit consent.
# Project supplied by the operator: ypdavv5xq6. Empty disables collection.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Stock market: disabled in Production until licensing + actual widget display checks pass.
# Development preview is available without this flag. Rebuild after changing it.
# See docs/stock-market-spec.md before enabling. No quote API key is needed.
STOCK_MARKET_ENABLED=false
